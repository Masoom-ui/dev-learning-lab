# Copy to .env and adjust as needed
APP_NAME=Dev Learning Lab API
DEBUG=true

# PostgreSQL (docker compose)
DATABASE_URL=postgresql://devlab:devlab@localhost:5432/devlab

# MongoDB (docker compose)
MONGODB_URL=mongodb://devlab:devlab@localhost:27017/devlab?authSource=admin

# Auth (Lesson 8 — change JWT_SECRET in production)
JWT_SECRET=dev-learning-lab-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
